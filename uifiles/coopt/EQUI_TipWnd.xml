<?xml version = "1.0"?>
<XML ID = "EQInterfaceDefinitionLanguage">
	<Schema xmlns = "EverQuestData" xmlns:dt = "EverQuestDataTypes"/>

	<!-- ============================================================
	     CoOpt native Command Center, hosted in the Tip of the Day
	     window (nobody misses it). Every stock element keeps its
	     ScreenID (the client writes tip text / wires its buttons by
	     these) but is parked offscreen; the CoOpt launcher grid and
	     status line take over the visible window. Buttons are
	     Style_Checkbox so clicks latch for the native_bridge poll.
	     Open with /itemui center (or the EQ menu's Tip of the Day).
	     ============================================================ -->

	<STMLbox item = "TIP_Display">
		<ScreenID>Display</ScreenID>
		<DrawTemplate>WDT_Inner</DrawTemplate>
		<RelativePosition>true</RelativePosition>
		<AutoStretch>true</AutoStretch>
		<LeftAnchorOffset>0</LeftAnchorOffset>
		<TopAnchorOffset>-1010</TopAnchorOffset>
		<RightAnchorOffset>10</RightAnchorOffset>
		<BottomAnchorOffset>-1000</BottomAnchorOffset>
		<LeftAnchorToLeft>true</LeftAnchorToLeft>
		<RightAnchorToLeft>true</RightAnchorToLeft>
		<TopAnchorToTop>true</TopAnchorToTop>
		<BottomAnchorToTop>true</BottomAnchorToTop>
		<Style_VScroll>false</Style_VScroll>
		<Style_Border>false</Style_Border>
	</STMLbox>

	<Combobox item = "TIP_History">
		<ScreenID>History</ScreenID>
